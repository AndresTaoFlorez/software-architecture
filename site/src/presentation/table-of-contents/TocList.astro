---
interface Item { slug: string; text: string; children: Item[] }
interface Props { items: Item[]; depth?: number }
const { items, depth = 0 } = Astro.props;
---
<ul>
  {items.map(item => <li>
    <a href={'#' + item.slug} style={`--toc-depth:${depth}`} aria-current={item.slug === '_top' ? 'true' : undefined}>{item.text}</a>
    {item.children.length > 0 && <Astro.self items={item.children} depth={depth + 1} />}
  </li>)}
</ul>
<style>
  ul { list-style: none; padding: 0; margin: 0; }
  a { display: block; border-radius: .25rem; padding: .25rem .5rem; padding-inline-start: calc(.5rem + var(--toc-depth) * 1rem); line-height: 1.25; }
  a[aria-current='true'] { color: var(--sl-color-text-accent); font-weight: 600; }
</style>
