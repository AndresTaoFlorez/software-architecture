{
  "name": "software-architecture-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run test:scripts && npm run check:examples && npm run check:glossary && npm run check:docs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:examples": "node scripts/shared-order-example.mjs --check",
    "sync:examples": "node scripts/shared-order-example.mjs --write",
    "check:glossary": "node scripts/glossary-links.mjs --check",
    "check:docs": "node scripts/docs-quality.mjs"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "typescript": "6.0.3",
    "zod": "4.6.5"
  }
}
